{
  "name": "oh-my-skills",
  "version": "1.2.0",
  "description": "Local dashboard and CLI for managing AI agent skills across tools, projects, SkillHub, and Git repositories.",
  "type": "module",
  "bin": {
    "oh-my-skills": "bin/oh-my-skills.mjs",
    "oms": "bin/oh-my-skills.mjs"
  },
  "files": [
    "dist",
    "server",
    "bin",
    "skills",
    "package.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node server/main.mjs",
    "serve": "node bin/oh-my-skills.mjs start",
    "stop": "node bin/oh-my-skills.mjs stop",
    "restart": "node bin/oh-my-skills.mjs restart",
    "typecheck": "rimraf tsconfig.tsbuildinfo && tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "oh-my-skills",
    "skill-management",
    "skillhub",
    "agents",
    "skills",
    "agent-skills",
    "codex",
    "claude",
    "cursor"
  ],
  "homepage": "https://github.com/duzhenxun/oh-my-skills#readme",
  "bugs": {
    "url": "https://github.com/duzhenxun/oh-my-skills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duzhenxun/oh-my-skills.git"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Zhenxun Du <duzhenxun@126.com>",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.15.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uiw/react-codemirror": "^4.25.9",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.5.16",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.1"
  }
}
